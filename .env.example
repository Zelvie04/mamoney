# Скопируй в .env и заполни на сервере. В git не коммитить.
BOT_TOKEN=
# Секрет в пути вебхука, любая длинная случайная строка
WEBHOOK_SECRET=
PUBLIC_URL=https://mamoney.zelv04.ru
DATABASE_URL=postgres://mamoney:${POSTGRES_PASSWORD}@db:5432/mamoney
OPENROUTER_API_KEY=
# Свой сервер с моделью вместо OpenRouter (Ollama, llama.cpp): AI_BASE_URL=http://ollama:11434/v1, AI_MODELS=qwen2.5:1.5b
# AI_BASE_URL=
# AI_MODELS=auto
ADMIN_CHAT_ID=
DEFAULT_TIMEZONE=Europe/Moscow
# Подпись валюты до выбора пользователем (ISO-код или любое слово)
DEFAULT_CURRENCY=денег
# Только для разового переноса из n8n
LEGACY_DATABASE_URL=

# --- deploy/docker-compose.yml ---
POSTGRES_PASSWORD=
APP_HOST=mamoney.zelv04.ru
# Сеть, entrypoint и certresolver Traefik из /opt/beget/n8n/docker-compose.yml
TRAEFIK_NETWORK=n8n_default
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge
